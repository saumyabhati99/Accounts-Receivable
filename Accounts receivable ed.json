        "messages": {
          "values": [
            {
              "content": "=You are an Accounts Receivable specialist. \nWrite a payment reminder email.\n\nRules:\n- Start with \"Dear {{ $json[\"Name\"] }},\"\n- No subject line\n- Max 100 words\n- Mention Invoice ID and Amount\n- End with \"Best regards, The Accounts Receivable Team\"\n\nTone based on Days Overdue:\n- 1-7 days: Friendly\n- 8-14 days: Firm\n- 15-29 days: Urgent\n- 30+ days: Final Notice\n\nInvoice ID: {{ $json[\"Invoice ID\"] }}\nAmount: ${{ $json[\"Invoice Amount\"] }}\nDue Date: {{ $json[\"Due Date\"] }}\nDays Overdue: {{ $now.diff(DateTime.fromISO($json[\"Due Date\"]), 'days') }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 500,
          "temperature": 0.4
        }
